meta {
  name: Change-Password
  type: http
  seq: 6
}

put {
  url: {{URL}}/api/admin/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: your_access_token_here
}

body:json {
  { "oldPassword": "your_password_here",
   "newPassword": "your_new_password_here" }
}

settings {
  encodeUrl: true
  timeout: 0
}
