meta {
  name: Create-Experience
  type: http
  seq: 5
}

post {
  url: {{URL}}/api/admin/experience
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  { "company": "New Company",
   "role": "Software Engineer",
   "location": "Singapore",
   "employment_type": "Full-time",
   "start_date": "2024-01-01",
   "is_current": true,
   "sort_order": 1 }
}

settings {
  encodeUrl: true
  timeout: 0
}
