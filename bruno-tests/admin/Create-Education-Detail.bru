  token: {{accessToken}}
}

body:json {
  { "education_id": "your_education_id_here",
   "detail": "Technical Assistance - Organiser of The Ultimate Typing Competition (2021).",
   "sort_order": 1 }
}

settings {
  encodeUrl: true
  timeout: 0
}
